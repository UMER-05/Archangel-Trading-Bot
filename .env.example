# =====================================================
# ARCHANGEL TRADING BOT - BACKEND ENVIRONMENT CONFIGURATION
# =====================================================
# Every name below is one the backend actually reads. (An earlier version of
# this template used MONGODB_URI, RPC_URL and RAYDIUM_AUTO_BUY, which the code
# never reads, and left out SOLAMI_BLUR_API_KEY and JUPITER_AUTO_BUY — a .env
# built from it could start but never buy anything.)
#
# WHERE THIS FILE GOES: backend/.env (the backend loads .env from the folder
# it is started in, so start it from backend/).
#
# On startup the backend logs a "[trading readiness]" line for each gate
# below — check those first if the bot is not buying.

# =====================================================
# REQUIRED — the bot cannot start or cannot trade without these
# =====================================================
# MongoDB connection string. The app exits on startup without it.
# Use a database of its own for each running copy of the bot: every token is
# processed once per DATABASE, so two copies sharing one database split the
# tokens between them and each looks like it is "not picking trades".
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=archangel

# Token discovery (Solami Blur realtime stream; key needs the DataApi
# permission). Without it NO new tokens are discovered.
SOLAMI_BLUR_API_KEY=
# Optional regional endpoint, e.g. wss://fra.ws.solami.dev/data/subscribe
SOLAMI_BLUR_WS_URL=wss://ws.solami.dev/data/subscribe
# Optional comma-separated allow-list of DEX names (empty = all)
SOLAMI_BLUR_DEXES=

# Auto-buy master switch. Must be exactly "true" — anything else means
# tokens are discovered and filtered but never bought.
JUPITER_AUTO_BUY=true

# "true" sends real on-chain swaps. Anything else SIMULATES buys
# (recommended while testing).
USE_REAL_SWAP=false

# Solana RPC. Use a paid provider (e.g. Helius). Unset falls back to the
# public mainnet RPC, which commonly refuses the holder-distribution query
# the safety filter needs — so every token gets rejected.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_WS_URL=
SOLANA_COMMITMENT=confirmed
# When set, position monitoring and emergency exits use Helius RPC with this
# key instead of SOLANA_RPC_URL.
HELIUS_API_KEY=

# =====================================================
# WALLETS
# =====================================================
# Operator (bot) wallet that signs auto-buys: base58 secret key or JSON array.
# WALLET_PRIVATE_KEY and SECRET_KEY are accepted as alternative names.
# Leave unset (do NOT leave a placeholder) if only user hot wallets trade.
WALLET_SECRET_KEY=
WALLET_PUBLIC_KEY=

# Wallet allowed to pause/resume auto-buys for everyone (defaults to
# WALLET_PUBLIC_KEY) and the server-side signer for auto-sells.
ADMIN_WALLET_PUBKEY=
ADMIN_WALLET_SECRET=

# Encrypts every user's generated hot-wallet key at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back it up separately — losing it makes stored user wallets unrecoverable.
WALLET_ENCRYPTION_KEY=

# =====================================================
# JUPITER (quotes + swaps)
# =====================================================
# api.jup.ag needs JUPITER_API_KEY; lite-api.jup.ag is keyless.
JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=
# Default slippage (%) and priority fee (SOL); per-wallet Trading Settings
# can override both.
AUTO_BUY_SLIPPAGE_PCT=10
JUPITER_PRIORITY_FEE=0.00003
# Send Jupiter swaps through a Jito/MEV relay (both must be set)
JITO_MEV_RELAY_ENABLED=false
JITO_MEV_RELAY_URL=

# =====================================================
# SAFETY FILTERS (applied to every discovered token)
# =====================================================
MAX_BUY_TAX_PCT=5
MAX_SELL_TAX_PCT=5
REQUIRE_MINT_DISABLED=true
REQUIRE_FREEZE_DISABLED=true
REQUIRE_LP_LOCKED=false

# =====================================================
# RISK / SIZING DEFAULTS (per-wallet Trading Settings override these)
# =====================================================
MIN_MARKETCAP_SOL=3
TP_PCT=0.10
SL_PCT=0.30
# No longer limits buys: the size of an auto-buy is the trader's fixed amount
# or balance split, and a manual buy is whatever the user types. Kept only
# so older .env files still load.
MAX_RISK_PER_TRADE_PCT=2
MAX_DAILY_LOSS_PCT=6
# 0 = uncapped
MAX_OPEN_POSITIONS=0
# Wallets below this SOL balance are skipped for auto-trading
MIN_AUTO_TRADE_SOL=0.003
# The SIZE of each auto-buy is not set here: it comes from each wallet's
# Trading Settings in the dashboard (balance split across Max Open Positions,
# or a fixed SOL amount). So is the minimum token age.

# =====================================================
# AUTOMATIC EXITS (position monitor)
# =====================================================
# Trailing stop: arms once price is up this fraction, sells on this drop
TRAILING_ACTIVATION_PCT=0.15
TRAILING_STOP_PCT=0.05
# Tiered profit-taking (fractions) and % of position sold at each tier
TIER1_PROFIT_PCT=0.4
TIER2_PROFIT_PCT=0.8
TIER3_PROFIT_PCT=1.5
TIER_SELL_PCT=30
# Slippage (%) used for automatic exit sells
DEFAULT_SLIPPAGE_PCT=1
# Slippage (%) the admin force-sell uses
ADMIN_FORCE_SLIPPAGE=1

# =====================================================
# RAYDIUM NATIVE EXECUTION (optional; off = every buy goes through Jupiter)
# =====================================================
RAYDIUM_NATIVE_EXECUTION_ENABLED=false
RAYDIUM_CPMM_EXECUTOR_ENABLED=false

# =====================================================
# SERVER
# =====================================================
PORT=4000
# Exact origin the dashboard is opened from (scheme + host + port), for CORS,
# e.g. http://your-server-ip or https://your-domain. If it doesn't match, the
# browser blocks the dashboard's requests — including turning auto-trade on.
FRONTEND_URL=http://localhost:3000
# "production" = JSON logs at info level; anything else = pretty debug logs.
NODE_ENV=production

# Cache lifetimes in milliseconds (defaults shown)
CACHE_TOKEN_METADATA_TTL=300000
CACHE_TOKEN_PRICE_TTL=10000
CACHE_TOKEN_DISCOVERY_TTL=30000
CACHE_QUOTE_TTL=5000

# =====================================================
# ALERTS (optional)
# =====================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# =====================================================
# SETTINGS THAT DO NOTHING — don't rely on them
# =====================================================
# These appear in older .env files but the auto-buy path never reads them
# (left over from removed features, or only declared and never used).
# Changing them will NOT change what or how much the bot buys:
#   JUPITER_AUTO_BUY_SOL, AUTO_BUY_AMOUNT, AUTO_TRADE_PERCENT_OF_BALANCE
#       -> buy size comes from each wallet's Trading Settings
#   MIN_SECONDS_SINCE_LAUNCH, MAX_SECONDS_SINCE_LAUNCH
#       -> minimum token age is the per-wallet dashboard setting
#   TOKEN_MIN_MARKETCAP_SOL   -> use MIN_MARKETCAP_SOL
#   RPC_URL                   -> use SOLANA_RPC_URL
#   TOKEN_BLACKLIST, TOKEN_WHITELIST, CUSTOM_RPC_URL, ENABLE_BUNDLE_PRESIGN,
#   MIN_JUPITER_LIQUIDITY_SOL, SNIPER_MIN_LIQUIDITY_SOL,
#   STORED_TOKEN_CHECKER_ENABLED, STORED_TOKEN_CHECK_INTERVAL_MS,
#   MAX_TOKENS_PER_CHECK, MIN_TIME_BETWEEN_TOKEN_CHECKS,
#   JUPITER_DISCOVERY_POLL_MS, MAX_SLIPPAGE_PCT, SL_GRACE_PERIOD_MS,
#   DEFAULT_TAKE_PROFIT_PCT, DEFAULT_STOP_LOSS_PCT (use TP_PCT / SL_PCT),
#   MANUAL_BUY_DEFAULT_SLIPPAGE_PCT, BACKEND_RECEIVER_WALLET
# TRADING_MODE and MIN_TOKEN_SCORE only affect manual-trade checks and the
# config screen, not auto-buy.
